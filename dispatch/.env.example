# Dispatch app environment (optional in dev — Vite proxies /api to localhost:3001)

# Point the frontend at a deployed API instead of the Vite proxy. Trailing /api required.
# VITE_API_URL=https://selfie-api-sqgh.onrender.com/api

# Dev proxy target for the Express server (defaults to http://localhost:3001).
# VITE_API_TARGET=http://localhost:3001