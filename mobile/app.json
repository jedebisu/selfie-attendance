{
  "expo": {
    "name": "EBISU T&A",
    "slug": "selfie-attendance",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jedebisu.selfieattendance",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take attendance photos",
        "NSLocationWhenInUseUsageDescription": "We need your location to record your attendance clock in and out",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location is tracked in the background only while you are clocked in, so the office can verify work locations",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.jedebisu.selfieattendance",
      "enableDangerousExperimentalLeanBuilds": true,
      "minSdkVersion": 21,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB5rkLpbkqqIMo6FYMVj7gqoLGH3uGWoWg"
        }
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 12
    },
    "extra": {
      "eas": {
        "projectId": "72936711-ce2c-4e50-bcac-9e76c80abd4c"
      }
    },
    "owner": "jedebisu"
  }
}
