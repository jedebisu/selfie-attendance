{
  "expo": {
    "name": "EBISU T&A",
    "slug": "selfie-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jedebisu.selfieattendance",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take attendance photos",
        "NSLocationWhenInUseUsageDescription": "We need your location to record attendance"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.jedebisu.selfieattendance",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "72936711-ce2c-4e50-bcac-9e76c80abd4c"
      }
    },
    "owner": "jedebisu"
  }
}
