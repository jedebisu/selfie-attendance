{
  "expo": {
    "name": "Selfie Attendance",
    "slug": "selfie-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.selfieattendance",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take attendance photos",
        "NSLocationWhenInUseUsageDescription": "We need your location to record attendance"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.yourcompany.selfieattendance",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"]
    }
  }
}
