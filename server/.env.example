# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=selfie_attendance
DB_PASSWORD=postgres
DB_PORT=5432

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-key-change-this

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=62914560

# ---------------------------------------------------------------------------
# Globe FSM sync (fsmSync.js). Do NOT enable without real credentials.
# Globe's public catalog has no FSM work-order API; this picks up authorized
# CSV exports via SFTP, a local folder (dev), or a Globe-provided static URL.
# ---------------------------------------------------------------------------
FSM_SYNC_ENABLED=false
FSM_SYNC_MODE=folder              # folder | sftp | http
FSM_SYNC_FOLDER=                  # folder mode: local inbox directory (e.g. ./data/fsm-inbox)
FSM_SYNC_ARCHIVE=                 # folder mode: optional dir to move processed files into
FSM_SYNC_HTTP_URL=                # http mode only: a Globe-provided static CSV export URL
FSM_SYNC_STARTUP_DELAY_MIN=       # optional: delay before first run (default 0.5 min)
FSM_SYNC_INTERVAL_MIN=30          # scheduler cadence
FSM_SFTP_HOST=                    # SFTP export host (ask Globe)
FSM_SFTP_PORT=22
FSM_SFTP_USERNAME=                # SFTP username
FSM_SFTP_PASSWORD=                # SFTP password OR set FSM_SFTP_PRIVATE_KEY
FSM_SFTP_PRIVATE_KEY=             # path to an SSH private key file
FSM_SFTP_PICKUP_PATH=             # remote folder the exports land in
FSM_SFTP_ARCHIVE_PATH=            # remote folder to move processed files into
FSM_SFTP_RETRIES=3
